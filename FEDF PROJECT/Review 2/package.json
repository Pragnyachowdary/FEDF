{
  "name": "live-hospital-bed-monitoring",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install --workspaces",
    "seed": "npm --workspace server run seed",
    "dev-server": "npm --workspace server run dev",
    "dev-client": "npm --workspace client run dev",
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
